const RING_R0: float = 8.0
const RING_STEP: float = 58.0
static var _ring_cache: Dictionary = {}


# The ring a node sits on: 0 for the core, else its parent's ring + 1.
static func get_ring(node_id: String) -> int:
	if _ring_cache.has(node_id):
		return int(_ring_cache[node_id])
	var def: Dictionary = get_node_def(node_id)
	var ring: int = 0
	var parent_id: String = String(def.get("parent", ""))
	if parent_id != "":
		ring = get_ring(parent_id) + 1
	_ring_cache[node_id] = ring
	return ring


static func ring_radius(ring: int) -> float:
	return 0.0 if ring <= 0 else RING_R0 + RING_STEP * float(ring)


static func max_ring() -> int:
	var best: int = 0
	for n: Dictionary in NODES:
		best = maxi(best, get_ring(String(n["id"])))
	return best


# The EVOLVE node for a sub weapon (player.SUB_WEAPONS id), or "" if it has none.
static func get_evolution_node(sub_id: String) -> String:
	for n: Dictionary in NODES:
		if String(n.get("evolves", "")) == sub_id:
			return String(n["id"])
	return ""


static func get_node_def(node_id: String) -> Dictionary:
	for n: Dictionary in NODES:
		if String(n["id"]) == node_id:
			return n
	return {}


static func get_ship_def(ship_id: String) -> Dictionary:
	for s: Dictionary in SHIPS:
		if String(s["id"]) == ship_id:
			return s
	return SHIPS[0]


# Returns the id of the tree node that adds this draft upgrade to the pool, or "" for base-pool upgrades.
static func get_upgrade_unlock_node(upgrade_id: String) -> String:
	for n: Dictionary in NODES:
		if String(n.get("unlocks_upgrade", "")) == upgrade_id:
			return String(n["id"])
	return ""
